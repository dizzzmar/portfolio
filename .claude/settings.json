{
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "my-skills": {
      "source": {
        "source": "github",
        "repo": "dizzzmar/my-skills"
      }
    }
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "emil-skills@my-skills": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -C \"$CLAUDE_PROJECT_DIR\" config --replace-all remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*' || true"
          }
        ]
      }
    ]
  }
}
